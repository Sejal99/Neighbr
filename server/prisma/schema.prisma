generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model schema_migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model societies {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(150)
  address             String
  timezone            String                @default("Asia/Kolkata") @db.VarChar(100)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  complaints          complaints[]
  facilities          facilities[]
  society_memberships society_memberships[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model society_memberships {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id  String    @db.Uuid
  user_id     String    @db.Uuid
  role        String    @db.VarChar(20)
  unit_number String?   @db.VarChar(50)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  societies   societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([society_id, user_id])
  @@index([society_id], map: "idx_society_memberships_society_id")
  @@index([user_id], map: "idx_society_memberships_user_id")
}

model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name           String                @db.VarChar(150)
  email               String                @unique @db.VarChar(255)
  password_hash       String
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  assigned_complaints complaints[]          @relation("ComplaintAssignee")
  complaints          complaints[]
  facility_bookings   facility_bookings[]
  society_memberships society_memberships[]
}

model complaints {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id    String    @db.Uuid
  user_id       String    @db.Uuid
  title         String    @db.VarChar(150)
  description   String
  category      String    @db.VarChar(50)
  status        String    @default("open") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  assigned_to   String?   @db.Uuid
  assigned_user users?    @relation("ComplaintAssignee", fields: [assigned_to], references: [id], onUpdate: NoAction)
  societies     societies @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([society_id], map: "idx_complaints_society_id")
  @@index([status], map: "idx_complaints_status")
  @@index([user_id], map: "idx_complaints_user_id")
  @@index([assigned_to], map: "idx_complaints_assigned_to")
}

model facilities {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id        String              @db.Uuid
  name              String              @db.VarChar(100)
  description       String?
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  societies         societies           @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facility_bookings facility_bookings[]

  @@index([society_id], map: "idx_facilities_society_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model facility_bookings {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility_id  String     @db.Uuid
  user_id      String     @db.Uuid
  booking_date DateTime   @db.Date
  start_time   DateTime   @db.Time(6)
  end_time     DateTime   @db.Time(6)
  status       String     @default("confirmed") @db.VarChar(20)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  facilities   facilities @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([facility_id, booking_date], map: "idx_facility_bookings_facility_date")
}
