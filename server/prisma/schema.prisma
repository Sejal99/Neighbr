generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model schema_migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model societies {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(150)
  address             String
  timezone            String                @default("Asia/Kolkata") @db.VarChar(100)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  society_memberships society_memberships[]
  complaints          complaints[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model society_memberships {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id  String       @db.Uuid
  user_id     String       @db.Uuid
  role        String       @db.VarChar(20)
  unit_number String?      @db.VarChar(50)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  societies   societies    @relation(fields: [society_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  complaints  complaints[]

  @@unique([society_id, user_id])
  @@index([society_id], map: "idx_society_memberships_society_id")
  @@index([user_id], map: "idx_society_memberships_user_id")
}

model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name           String                @db.VarChar(150)
  email               String                @unique @db.VarChar(255)
  password_hash       String
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  society_memberships society_memberships[]
  complaints          complaints[]
}

model complaints {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  society_id  String   @db.Uuid
  user_id     String   @db.Uuid
  title       String   @db.VarChar(150)
  description String
  category    String   @db.VarChar(50)
  status      String   @default("open") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  societies             societies            @relation(fields: [society_id], references: [id], onDelete: Cascade)
  users                 users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  societyMemberships    society_memberships? @relation(fields: [society_membershipsId], references: [id])
  society_membershipsId String?              @db.Uuid

  @@index([society_id])
  @@index([user_id])
  @@index([status])
}
